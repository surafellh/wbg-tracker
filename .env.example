# Supabase project settings: Project Settings > API
# Leave these empty (or delete .env) to run in LOCAL TEST MODE: data stays in your browser only,
# nothing touches the live database. Handy for trying changes on localhost.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Local test mode only: the approver code to use (default "approve"). Unit PINs are set in the Units tab.
VITE_LOCAL_APPROVER_CODE=
