# Supabase project settings: Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional. If set, the Units tab is only shown to people who enter this code (stored in their browser).
# This only hides the tab; it does not protect the data. Leave empty to show the Units tab to everyone.
VITE_ADMIN_CODE=
